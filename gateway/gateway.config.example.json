{
  "listen": {
    "host": "127.0.0.1",
    "port": 8000,
    "allow_non_loopback_bind": false,
    "open_files_target": 65535
  },
  "route": { "default": "zdr_cloud" },
  "keys": { "upstream_key_env": "GATEWAY_UPSTREAM_KEY" },
  "quota": {
    "identity_header": "x-user-id",
    "requests_per_day": 200,
    "tokens_per_day": 200000,
    "ledger_path": "./data/quota-ledger.json"
  },
  "logging": {
    "level": "info",
    "log_request_bodies": false,
    "file": "./data/gateway.log"
  },
  "health": { "cache_ms": 5000, "timeout_ms": 2500 },
  "timeouts": { "upstream_ms": 60000, "video_ms": 30000 },
  "max_body_bytes": 2097152,
